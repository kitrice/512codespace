 \u001b[39m6.371429\u001b[38;5;246m, \u001b[39m6.485714\u001b[38;5;246m, \u001b[39m6.\u2026\n$ station_max_temp_c                    \u001b[3m\u001b[38;5;246m<dbl>\u001b[39m\u001b[23m 29.4\u001b[38;5;246m, \u001b[39m31.7\u001b[38;5;246m, \u001b[39m32.2\u001b[38;5;246m, \u001b[39m33.3\u001b[38;5;246m, \u001b[39m35.0\u001b[38;5;246m, \u001b[39m34\u2026\n$ station_min_temp_c                    \u001b[3m\u001b[38;5;246m<dbl>\u001b[39m\u001b[23m 20.0\u001b[38;5;246m, \u001b[39m22.2\u001b[38;5;246m, \u001b[39m22.8\u001b[38;5;246m, \u001b[39m23.3\u001b[38;5;246m, \u001b[39m23.9\u001b[38;5;246m, \u001b[39m23\u2026\n$ station_precip_mm                     \u001b[3m\u001b[38;5;246m<dbl>\u001b[39m\u001b[23m 16.0\u001b[38;5;246m, \u001b[39m8.6\u001b[38;5;246m, \u001b[39m41.4\u001b[38;5;246m, \u001b[39m4.0\u001b[38;5;246m, \u001b[39m5.8\u001b[38;5;246m, \u001b[39m39.1\u001b[38;5;246m,\u001b[39m\u2026\n```\n\n### Cell 5\n\n#### Metadata\n\n```yaml\nid: e3f17ed0\ntype: markdown\n```\n\n#### Source\n\n```\n## 1. Count the missing values\n\n<details>\n<summary>Hint</summary>\n\n```R\ndengue |>\n    summarize(across(everything(), \\(x) sum(is.na(x)))) |>\n    pivot_longer(everything(), names_to = 'column', values_to = 'n_missing') |>\n    arrange(desc(n_missing))\n```\n\n</details>```\n\n### Cell 6\n\n#### Metadata\n\n```yaml\nexecution_count: 6\nid: cc45fa25\ntype: code\n```\n\n#### Source\n\n```python\ndengue |>\n    summarize(across(everything(), \\(x) sum(is.na(x)))) |>\n    pivot_longer(everything(), names_to = 'column', values_to = 'n_missing') |>\n    arrange(desc(n_missing))\n```\n\n#### Output\n\n```\n   column                                n_missing\n1  ndvi_ne                               194      \n2  ndvi_nw                                52      \n3  station_avg_temp_c                     43      \n4  station_diur_temp_rng_c                43      \n5  ndvi_se                                22      \n6  ndvi_sw                                22      \n7  station_precip_mm                      22      \n8  station_max_temp_c                     20      \n9  station_min_temp_c                     14      \n10 precipitation_amt_mm                   13      \n11 reanalysis_sat_precip_amt_mm           13      \n12 reanalysis_air_temp_k                  10      \n13 reanalysis_avg_temp_k                  10      \n14 reanalysis_dew_point_temp_k            10      \n15 reanalysis_max_air_temp_k              10      \n16 reanalysis_min_air_temp_k              10      \n17 reanalysis_precip_amt_kg_per_m2        10      \n18 reanalysis_relative_humidity_percent   10      \n19 reanalysis_specific_humidity_g_per_kg  10      \n20 reanalysis_tdtr_k                      10      \n21 city                                    0      \n22 year                                    0      \n23 weekofyear                              0      \n24 week_start_date                         0      ```\n\n### Cell 7\n\n#### Metadata\n\n```yaml\nid: 3cdb5429\ntype: markdown\n```\n\n#### Source\n\n```\n## 2. Fill the missing values\n\nSort by date. Fill each city on its own. Keep 4 features. Join the labels.\n\n<details>\n<summary>Hint</summary>\n\n```R\npreprocess_data = function(features, labels = NULL) {\n    keep = c(\n        'city', 'year', 'weekofyear', 'week_start_date',\n        'reanalysis_specific_humidity_g_per_kg',\n        'reanalysis_dew_point_temp_k',\n        'station_avg_temp_c',\n        'station_min_temp_c'\n    )\n    df = features |>\n        select(all_of(keep)) |>\n        arrange(city, week_start_date) |>\n        group_by(city) |>\n        fill(everything(), .direction = 'down') |>\n        ungroup()\n    if (!is.null(labels)) {\n        df = df |> left_join(labels, by = c('city', 'year', 'weekofyear'))\n    }\n    df\n}\n\ndengue_processed = preprocess_data(dengue, labels)\n\ndengue_processed |> summarize(across(everything(), \\(x) sum(is.na(x))))\n```\n\n</details>```\n\n### Cell 8\n\n#### Metadata\n\n```yaml\nexecution_count: 7\nid: caef8853\ntype: code\n```\n\n#### Source\n\n```python\npreprocess_data = function(features, labels = NULL) {\n    keep = c(\n        'city', 'year', 'weekofyear', 'week_start_date',\n        'reanalysis_specific_humidity_g_per_kg',\n        'reanalysis_dew_point_temp_k',\n        'station_avg_temp_c',\n        'station_min_temp_c'\n    )\n    df = features |>\n        select(all_of(keep)) |>\n        arrange(city, week_start_date) |>\n        group_by(city) |>\n        fill(everything(), .direction = 'down') |>\n        ungroup()\n    if (!is.null(labels)) {\n        df = df |> left_join(labels, by = c('city', 'year', 'weekofyear'))\n    }\n    df\n}\n\ndengue_processed = preprocess_data(dengue, labels)\n\ndengue_processed |> summarize(across(everything(), \\(x) sum(is.na(x))))\n```\n\n#### Output\n\n```\n  city year weekofyear week_start_date reanalysis_specific_humidity_g_per_kg\n1 0    0    0          0               0                                    \n  reanalysis_dew_point_temp_k station_avg_temp_c station_min_temp_c total_cases\n1 0                           0                  0                  0          ```\n\n### Cell 9\n\n#### Metadata\n\n```yaml\nid: f1ec12a1\ntype: markdown\n```\n\n#### Source\n\n```\n## 3. Train and test sets, by city\n\n<details>\n<summary>Hint</summary>\n\n```R\ndengue_sj = dengue_processed |> filter(city == 'sj')\ndengue_iq = dengue_processed |> filter(city == 'iq')\n\nsj_train = dengue_sj |> slice(1:800)\nsj_test = dengue_sj |> slice(801:n())\n\niq_train = dengue_iq |> slice(1:400)\niq_test = dengue_iq |> slice(401:n())\n```\n\n</details>```\n\n### Cell 10\n\n#### Metadata\n\n```yaml\nexecution_count: 8\nid: 9962ce67\ntype: code\n```\n\n#### Source\n\n```python\ndengue_sj = dengue_processed |> filter(city == 'sj')\ndengue_iq = dengue_processed |> filter(city == 'iq')\n\nsj_train = dengue_sj |> slice(1:800)\nsj_test = dengue_sj |> slice(801:n())\n\niq_train = dengue_iq |> slice(1:400)\niq_test = dengue_iq |> slice(401:n())\n```\n\n### Cell 11\n\n#### Metadata\n\n```yaml\nid: 54d2068d\ntype: markdown\n```\n\n#### Source\n\n```\n## 4. Random forest, one model per city\n\n<details>\n<summary>Hint</summary>\n\n```R\nmod = rand_forest(trees = 500, min_n = 30) |> set_mode('regression')\n\nformula = total_cases ~ weekofyear + reanalysis_specific_humidity_g_per_kg +\n    reanalysis_dew_point_temp_k + station_avg_temp_c + station_min_temp_c\n\nmod_sj_fit = mod |> fit(formula, data = sj_train)\n\nmod_iq_fit = mod |> fit(formula, data = iq_train)\n```\n\n</details>```\n\n### Cell 12\n\n#### Metadata\n\n```yaml\nexecution_count: 9\nid: ef7b7bb4\ntype: code\n```\n\n#### Source\n\n```python\nmod = rand_forest(trees = 500, min_n = 30) |> set_mode('regression')\n\nformula = total_cases ~ weekofyear + reanalysis_specific_humidity_g_per_kg +\n    reanalysis_dew_point_temp_k + station_avg_temp_c + station_min_temp_c\n\nmod_sj_fit = mod |> fit(formula, data = sj_train)\n\nmod_iq_fit = mod |> fit(formula, data = iq_train)\n```\n\n### Cell 13\n\n#### Metadata\n\n```yaml\nid: 377fa91c\ntype: markdown\n```\n\n#### Source\n\n```\n## 5. Plot the test predictions\n\n<details>\n<summary>Hint</summary>\n\n```R\noptions(repr.plot.width = 10, repr.plot.height = 4, repr.plot.res = 250)\n\nsj_test |>\n    mutate(fitted = predict(mod_sj_fit, new_data = sj_test)$.pred, t = row_number()) |>\nggplot(aes(x = t)) +\n    geom_line(aes(y = total_cases, color = 'actual')) +\n    geom_line(aes(y = fitted, color = 'predicted')) +\n    labs(x = 'week', y = 'total_cases', color = NULL) +\n    theme_minimal()\n```\n\n</details>```\n\n### Cell 14\n\n#### Metadata\n\n```yaml\nexecution_count: 10\nid: b0405531\ntype: code\n```\n\n#### Source\n\n```python\noptions(repr.plot.width = 10, repr.plot.height = 4, repr.plot.res = 250)\n\nsj_test |>\n    mutate(fitted = predict(mod_sj_fit, new_data = sj_test)$.pred, t = row_number()) |>\nggplot(aes(x = t)) +\n    geom_line(aes(y = total_cases, color = 'actual')) +\n    geom_line(aes(y = fitted, color = 'predicted')) +\n    labs(x = 'week', y = 'total_cases', color = NULL) +\n    theme_minimal()\n```\n\n#### Output\n\n```\nplot without title```\n\n### Cell 15\n\n#### Metadata\n\n```yaml\nid: c07d8af2\ntype: markdown\n```\n\n#### Source\n\n```\n## 6. Lag features\n\nBuild these per city:\n\n- Rolling means (2, 4, 6, 8 weeks) of humidity, dew point, min temp, air temp, precipitation\n- Cases at t-1, t-2, t-4, and rolling means (4, 8 weeks) of cases up to t-1\n- `week_sin` and `week_cos`\n\n<details>\n<summary>Hint</summary>\n\n```R\n# Mean of the last w weeks (this week and the w - 1 before it)\n# .complete = TRUE gives NA for the first w - 1 weeks, which have too few weeks\nroll_mean = function(x, w) slider::slide_dbl(x, mean, .before = w - 1, .complete = TRUE)\n\nlag_data = dengue |>\n    select(\n        city, year, weekofyear, week_start_date,\n        humidity = reanalysis_specific_humidity_g_per_kg,\n        dew_point = reanalysis_dew_point_temp_k,\n        min_temp = station_min_temp_c,\n        air_temp = reanalysis_air_temp_k,\n        precip = precipitation_amt_mm\n    ) |>\n    left_join(labels, by = c('city', 'year', 'weekofyear')) |>\n    arrange(city, week_start_date) |>\n    group_by(city) |>\n    fill(everything(), .direction = 'down') |>\n    mutate(\n        across(\n            c(humidity, dew_point, min_temp, air_temp, precip),\n            list(\n                ma2 = ~roll_mean(.x, 2),\n                ma4 = ~roll_mean(.x, 4),\n                ma6 = ~roll_mean(.x, 6),\n                ma8 = ~roll_mean(.x, 8)\n            ),\n            .names = '{.col}_{.fn}'\n        ),\n        cases_lag1 = lag(total_cases, 1),\n        cases_lag2 = lag(total_cases, 2),\n        cases_lag4 = lag(total_cases, 4),\n        cases_ma4 = roll_mean(lag(total_cases, 1), 4),\n        cases_ma8 = roll_mean(lag(total_cases, 1), 8),\n        week_sin = sin(2 * pi * weekofyear / 52),\n        week_cos = cos(2 * pi * weekofyear / 52)\n    ) |>\n    ungroup() |>\n    drop_na() |>\n    # Keep only what the model uses: the rolling means, case lags and season\n    select(-c(year, week_start_date, humidity, dew_point, min_temp, air_temp, precip))\n```\n\n</details>```\n\n### Cell 16\n\n#### Metadata\n\n```yaml\nexecution_count: 11\nid: 836e7e55\ntype: code\n```\n\n#### Source\n\n```python\n# Mean of the last w weeks (this week and the w - 1 before it)\n# .complete = TRUE gives NA for the first w - 1 weeks, which have too few weeks\nroll_mean = function(x, w) slider::slide_dbl(x, mean, .before = w - 1, .complete = TRUE)\n\nlag_data = dengue |>\n    select(\n        city, year, weekofyear, week_start_date,\n        humidity = reanalysis_specific_humidity_g_per_kg,\n        dew_point = reanalysis_dew_point_temp_k,\n        min_temp = station_min_temp_c,\n        air_temp = reanalysis_air_temp_k,\n        precip = precipitation_amt_mm\n    ) |>\n    left_join(labels, by = c('city', 'year', 'weekofyear')) |>\n    arrange(city, week_start_date) |>\n    group_by(city) |>\n    fill(everything(), .direction = 'down') |>\n    mutate(\n        across(\n            c(humidity, dew_point, min_temp, air_temp, precip),\n            list(\n                ma2 = ~roll_mean(.x, 2),\n                ma4 = ~roll_mean(.x, 4),\n                ma6 = ~roll_mean(.x, 6),\n                ma8 = ~roll_mean(.x, 8)\n            ),\n            .names = '{.col}_{.fn}'\n        ),\n        cases_lag1 = lag(total_cases, 1),\n        cases_lag2 = lag(total_cases, 2),\n        cases_lag4 = lag(total_cases, 4),\n        cases_ma4 = roll_mean(lag(total_cases, 1), 4),\n        cases_ma8 = roll_mean(lag(total_cases, 1), 8),\n        week_sin = sin(2 * pi * weekofyear / 52),\n        week_cos = cos(2 * pi * weekofyear / 52)\n    ) |>\n    ungroup() |>\n    drop_na() |>\n    # Keep only what the model uses: the rolling means, case lags and season\n    select(-c(year, week_start_date, humidity, dew_point, min_temp, air_temp, precip))\n```\n\n### Cell 17\n\n#### Metadata\n\n```yaml\nid: 6e5a93fa\ntype: markdown\n```\n\n#### Source\n\n```\n## 7. Train and test sets for the lag features\n\nUse the same test size as before.\n\n<details>\n<summary>Hint</summary>\n\n```R\nsplit_city = function(city_name, n_test) {\n    d = lag_data |> filter(city == city_name) |> select(-city)\n    list(\n        train = d |> slice(1:(n() - n_test)),\n        test = d |> slice((n() - n_test + 1):n())\n    )\n}\n\nsj_lag_split = split_city('sj', nrow(sj_test))\niq_lag_split = split_city('iq', nrow(iq_test))\n```\n\n</details>```\n\n### Cell 18\n\n#### Metadata\n\n```yaml\nexecution_count: 12\nid: 11632b45\ntype: code\n```\n\n#### Source\n\n```python\nsplit_city = function(city_name, n_test) {\n    d = lag_data |> filter(city == city_name) |> select(-city)\n    list(\n        train = d |> slice(1:(n() - n_test)),\n        test = d |> slice((n() - n_test + 1):n())\n    )\n}\n\nsj_lag_split = split_city('sj', nrow(sj_test))\niq_lag_split = split_city('iq', nrow(iq_test))\n```\n\n### Cell 19\n\n#### Metadata\n\n```yaml\nid: d3cc2663\ntype: markdown\n```\n\n#### Source\n\n```\n## 8. Random forest with lag features\n\n<details>\n<summary>Hint</summary>\n\n```R\n# `total_cases ~ .` uses every other column in the data\nmod_sj_lag_fit = mod |> fit(total_cases ~ ., data = sj_lag_split$train)\n\nmod_iq_lag_fit = mod |> fit(total_cases ~ ., data = iq_lag_split$train)\n```\n\n</details>```\n\n### Cell 20\n\n#### Metadata\n\n```yaml\nexecution_count: 13\nid: 648afbdb\ntype: code\n```\n\n#### Source\n\n```python\n# `total_cases ~ .` uses every other column in the data\nmod_sj_lag_fit = mod |> fit(total_cases ~ ., data = sj_lag_split$train)\n\nmod_iq_lag_fit = mod |> fit(total_cases ~ ., data = iq_lag_split$train)\n```\n\n### Cell 21\n\n#### Metadata\n\n```yaml\nid: 36b78a2d\ntype: markdown\n```\n\n#### Source\n\n```\n## 9. Compare the test error (MAE)\n\n<details>\n<summary>Hint</summary>\n\n```R\nmae = function(fit, test) mean(abs(predict(fit, new_data = test)$.pred - test$total_cases))\n\ntibble(\n    city = c('sj', 'iq'),\n    baseline = c(mae(mod_sj_fit, sj_test), mae(mod_iq_fit, iq_test)),\n    lag_features = c(mae(mod_sj_lag_fit, sj_lag_split$test), mae(mod_iq_lag_fit, iq_lag_split$test))\n)\n```\n\n</details>```\n\n### Cell 22\n\n#### Metadata\n\n```yaml\nexecution_count: 14\nid: 19fd5de7\ntype: code\n```\n\n#### Source\n\n```python\nmae = function(fit, test) mean(abs(predict(fit, new_data = test)$.pred - test$total_cases))\n\ntibble(\n    city = c('sj', 'iq'),\n    baseline = c(mae(mod_sj_fit, sj_test), mae(mod_iq_fit, iq_test)),\n    lag_features = c(mae(mod_sj_lag_fit, sj_lag_split$test), mae(mod_iq_lag_fit, iq_lag_split$test))\n)\n```\n\n#### Output\n\n```\n  city baseline  lag_features\n1 sj   21.314946 9.856890    \n2 iq    6.558331 5.221833    ```\n\n### Cell 23\n\n#### Metadata\n\n```yaml\nid: 0d7e4eda\ntype: markdown\n```\n\n#### Source\n\n```\n## 10. Plot the comparison\n\n<details>\n<summary>Hint</summary>\n\n```R\nplot_compare = function(fit_base, test_base, fit_lag, test_lag, title) {\n    tibble(\n        t = seq_len(nrow(test_lag)),\n        actual = test_lag$total_cases,\n        baseline = predict(fit_base, new_data = test_base)$.pred,\n        lag_features = predict(fit_lag, new_data = test_lag)$.pred\n    ) |>\n        pivot_longer(-t) |>\n        ggplot(aes(t, value, color = name)) +\n        geom_line() +\n        labs(title = title, x = 'week', y = 'total_cases', color = NULL) +\n        theme_minimal()\n}\n\nplot_compare(mod_sj_fit, sj_test, mod_sj_lag_fit, sj_lag_split$test, 'San Juan')\nplot_compare(mod_iq_fit, iq_test, mod_iq_lag_fit, iq_lag_split$test, 'Iquitos')\n```\n\n</details>```\n\n### Cell 24\n\n#### Metadata\n\n```yaml\nexecution_count: 15\nid: 9505d924\ntype: code\n```\n\n#### Source\n\n```python\nplot_compare = function(fit_base, test_base, fit_lag, test_lag, title) {\n    tibble(\n        t = seq_len(nrow(test_lag)),\n        actual = test_lag$total_cases,\n        baseline = predict(fit_base, new_data = test_base)$.pred,\n        lag_features = predict(fit_lag, new_data = test_lag)$.pred\n    ) |>\n        pivot_longer(-t) |>\n        ggplot(aes(t, value, color = name)) +\n        geom_line() +\n        labs(title = title, x = 'week', y = 'total_cases', color = NULL) +\n        theme_minimal()\n}\n\nplot_compare(mod_sj_fit, sj_test, mod_sj_lag_fit, sj_lag_split$test, 'San Juan')\nplot_compare(mod_iq_fit, iq_test, mod_iq_lag_fit, iq_lag_split$test, 'Iquitos')\n```\n\n#### Output\n\n```\nplot without title```\n\n```\nplot without title```\n\n### Cell 25\n\n#### Metadata\n\n```yaml\nid: f9bb82cd\ntype: markdown\n```\n\n#### Source\n\n```\n## Bonus: variable importance\n\nMake a `vip` chart of the San Juan model with lag features. Which columns matter most?\n\n<details>\n<summary>Hint</summary>\n\n```R\n# importance = 'impurity' tells ranger to keep track of importance\nmod_imp = mod |> set_engine('ranger', importance = 'impurity')\n\nmod_sj_imp_fit = mod_imp |> fit(total_cases ~ ., data = sj_lag_split$train)\n\nvip::vip(mod_sj_imp_fit)\n```\n\n</details>```\n\n### Cell 26\n\n#### Metadata\n\n```yaml\nexecution_count: 16\nid: 048efb1e\ntype: code\n```\n\n#### Source\n\n```python\n# importance = 'impurity' tells ranger to keep track of importance\nmod_imp = mod |> set_engine('ranger', importance = 'impurity')\n\nmod_sj_imp_fit = mod_imp |> fit(total_cases ~ ., data = sj_lag_split$train)\n\nvip::vip(mod_sj_imp_fit)\n```\n\n#### Output\n\n```\nplot without title```"
