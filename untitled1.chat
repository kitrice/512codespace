},\n   {\n    \"cell_type\": \"markdown\",\n@@ -288,11 +450,52 @@\n   },\n   {\n    \"cell_type\": \"code\",\n-   \"execution_count\": null,\n+   \"execution_count\": 11,\n    \"id\": \"836e7e55\",\n    \"metadata\": {},\n    \"outputs\": [],\n-   \"source\": []\n+   \"source\": [\n+    \"# Mean of the last w weeks (this week and the w - 1 before it)\\n\",\n+    \"# .complete = TRUE gives NA for the first w - 1 weeks, which have too few weeks\\n\",\n+    \"roll_mean = function(x, w) slider::slide_dbl(x, mean, .before = w - 1, .complete = TRUE)\\n\",\n+    \"\\n\",\n+    \"lag_data = dengue |>\\n\",\n+    \"    select(\\n\",\n+    \"        city, year, weekofyear, week_start_date,\\n\",\n+    \"        humidity = reanalysis_specific_humidity_g_per_kg,\\n\",\n+    \"        dew_point = reanalysis_dew_point_temp_k,\\n\",\n+    \"        min_temp = station_min_temp_c,\\n\",\n+    \"        air_temp = reanalysis_air_temp_k,\\n\",\n+    \"        precip = precipitation_amt_mm\\n\",\n+    \"    ) |>\\n\",\n+    \"    left_join(labels, by = c('city', 'year', 'weekofyear')) |>\\n\",\n+    \"    arrange(city, week_start_date) |>\\n\",\n+    \"    group_by(city) |>\\n\",\n+    \"    fill(everything(), .direction = 'down') |>\\n\",\n+    \"    mutate(\\n\",\n+    \"        across(\\n\",\n+    \"            c(humidity, dew_point, min_temp, air_temp, precip),\\n\",\n+    \"            list(\\n\",\n+    \"                ma2 = ~roll_mean(.x, 2),\\n\",\n+    \"                ma4 = ~roll_mean(.x, 4),\\n\",\n+    \"                ma6 = ~roll_mean(.x, 6),\\n\",\n+    \"                ma8 = ~roll_mean(.x, 8)\\n\",\n+    \"            ),\\n\",\n+    \"            .names = '{.col}_{.fn}'\\n\",\n+    \"        ),\\n\",\n+    \"        cases_lag1 = lag(total_cases, 1),\\n\",\n+    \"        cases_lag2 = lag(total_cases, 2),\\n\",\n+    \"        cases_lag4 = lag(total_cases, 4),\\n\",\n+    \"        cases_ma4 = roll_mean(lag(total_cases, 1), 4),\\n\",\n+    \"        cases_ma8 = roll_mean(lag(total_cases, 1), 8),\\n\",\n+    \"        week_sin = sin(2 * pi * weekofyear / 52),\\n\",\n+    \"        week_cos = cos(2 * pi * weekofyear / 52)\\n\",\n+    \"    ) |>\\n\",\n+    \"    ungroup() |>\\n\",\n+    \"    drop_na() |>\\n\",\n+    \"    # Keep only what the model uses: the rolling means, case lags and season\\n\",\n+    \"    select(-c(year, week_start_date, humidity, dew_point, min_temp, air_temp, precip))\\n\"\n+   ]\n   },\n   {\n    \"cell_type\": \"markdown\",\n@@ -324,11 +527,22 @@\n   },\n   {\n    \"cell_type\": \"code\",\n-   \"execution_count\": null,\n+   \"execution_count\": 12,\n    \"id\": \"11632b45\",\n    \"metadata\": {},\n    \"outputs\": [],\n-   \"source\": []\n+   \"source\": [\n+    \"split_city = function(city_name, n_test) {\\n\",\n+    \"    d = lag_data |> filter(city == city_name) |> select(-city)\\n\",\n+    \"    list(\\n\",\n+    \"        train = d |> slice(1:(n() - n_test)),\\n\",\n+    \"        test = d |> slice((n() - n_test + 1):n())\\n\",\n+    \"    )\\n\",\n+    \"}\\n\",\n+    \"\\n\",\n+    \"sj_lag_split = split_city('sj', nrow(sj_test))\\n\",\n+    \"iq_lag_split = split_city('iq', nrow(iq_test))\\n\"\n+   ]\n   },\n   {\n    \"cell_type\": \"markdown\",\n@@ -352,11 +566,16 @@\n   },\n   {\n    \"cell_type\": \"code\",\n-   \"execution_count\": null,\n+   \"execution_count\": 13,\n    \"id\": \"648afbdb\",\n    \"metadata\": {},\n    \"outputs\": [],\n-   \"source\": []\n+   \"source\": [\n+    \"# `total_cases ~ .` uses every other column in the data\\n\",\n+    \"mod_sj_lag_fit = mod |> fit(total_cases ~ ., data = sj_lag_split$train)\\n\",\n+    \"\\n\",\n+    \"mod_iq_lag_fit = mod |> fit(total_cases ~ ., data = iq_lag_split$train)\\n\"\n+   ]\n   },\n   {\n    \"cell_type\": \"markdown\",\n@@ -383,11 +602,32 @@\n   },\n   {\n    \"cell_type\": \"code\",\n-   \"execution_count\": null,\n+   \"execution_count\": 14,\n    \"id\": \"19fd5de7\",\n    \"metadata\": {},\n-   \"outputs\": [],\n-   \"source\": []\n+   \"outputs\": [\n+    {\n+     \"data\": {\n+      \"text/plain\": [\n+       \"  city baseline  lag_features\\n\",\n+       \"1 sj   21.314946 9.856890    \\n\",\n+       \"2 iq    6.558331 5.221833    \"\n+      ]\n+     },\n+     \"execution_count\": 14,\n+     \"metadata\": {},\n+     \"output_type\": \"execute_result\"\n+    }\n+   ],\n+   \"source\": [\n+    \"mae = function(fit, test) mean(abs(predict(fit, new_data = test)$.pred - test$total_cases))\\n\",\n+    \"\\n\",\n+    \"tibble(\\n\",\n+    \"    city = c('sj', 'iq'),\\n\",\n+    \"    baseline = c(mae(mod_sj_fit, sj_test), mae(mod_iq_fit, iq_test)),\\n\",\n+    \"    lag_features = c(mae(mod_sj_lag_fit, sj_lag_split$test), mae(mod_iq_lag_fit, iq_lag_split$test))\\n\",\n+    \")\\n\"\n+   ]\n   },\n   {\n    \"cell_type\": \"markdown\",\n@@ -423,11 +663,59 @@\n   },\n   {\n    \"cell_type\": \"code\",\n",
