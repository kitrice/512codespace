csv\"\n    }\n  },\n  {\n    \"name\": \"nyc311.csv\",\n    \"path\": \"data/nyc311.csv\",\n    \"sha\": \"b3f7f517b84208563058e3c4add3ee3fe4cb8dc5\",\n    \"size\": 27350102,\n    \"url\": \"https://api.github.com/repos/UNC-BIOS-512/jupyterlite/contents/data/nyc311.csv?ref=main\",\n    \"html_url\": \"https://github.com/UNC-BIOS-512/jupyterlite/blob/main/data/nyc311.csv\",\n    \"git_url\": \"https://api.github.com/repos/UNC-BIOS-512/jupyterlite/git/blobs/b3f7f517b84208563058e3c4add3ee3fe4cb8dc5\",\n    \"download_url\": \"https://raw.githubusercontent.com/UNC-BIOS-512/jupyterlite/main/data/nyc311.csv\",\n    \"type\": \"file\",\n    \"_links\": {\n      \"self\": \"https://api.github.com/repos/UNC-BIOS-512/jupyterlite/contents/data/nyc311.csv?ref=main\",\n      \"git\": \"https://api.github.com/repos/UNC-BIOS-512/jupyterlite/git/blobs/b3f7f517b84208563058e3c4add3ee3fe4cb8dc5\",\n      \"html\": \"https://github.com/UNC-BIOS-512/jupyterlite/blob/main/data/nyc311.csv\"\n    }\n  }\n]\n",
