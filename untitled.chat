            "kind": "other",
            "raw_input": {
              "content": "pred_own <- predict(fit_logit, new_data = gss, type = 'prob') |>\n    pull(.pred_yes)\n\npred_plus1 <- gss |>\n    mutate(educ = educ + 1) |>\n    predict(fit_logit, new_data = _, type = 'prob') |>\n    pull(.pred_yes)\n\nmean(pred_plus1 - pred_own)\n",
              "file_path": "exercises/10-marginal-effect-exercise.ipynb",
